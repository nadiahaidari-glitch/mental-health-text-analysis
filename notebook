      "source": [
        "suicide_text = \" \".join(\n",
        "    df[df[\"class\"] == \"suicide\"][\"text\"].astype(str)\n",
        ").lower()\n",
        "\n",
        "non_suicide_text = \" \".join(\n",
        "    df[df[\"class\"] == \"non-suicide\"][\"text\"].astype(str)\n",
        ").lower()\n",
        "suicide_words = re.findall(r'\\b[a-z]+\\b', suicide_text)\n",
        "non_suicide_words = re.findall(r'\\b[a-z]+\\b', non_suicide_text)\n",
        "\n",
        "suicide_counter = Counter(suicide_words)\n",
        "non_suicide_counter = Counter(non_suicide_words)\n",
        "comparison_data = []\n",
        "\n",
        "for word in emotion_words:\n",
        "    comparison_data.append([\n",
        "        word,\n",
        "        suicide_counter[word],\n",
        "        non_suicide_counter[word]\n",
        "    ])\n",
        "\n",
        "comparison_df = pd.DataFrame(\n",
        "    comparison_data,\n",
        "    columns=[\"Word\", \"Suicide\", \"Non-Suicide\"]\n",
        ")\n",
        "comparison_melted = comparison_df.melt(\n",
        "    id_vars=\"Word\",\n",
        "    var_name=\"Category\",\n",
        "    value_name=\"Count\"\n",
        ")\n",
        "plt.figure(figsize=(14,6))\n",
        "\n",
        "sns.barplot(\n",
        "    data=comparison_melted,\n",
        "    x=\"Word\",\n",
        "    y=\"Count\",\n",
        "    hue=\"Category\"\n",
        ")\n",
        "\n",
        "plt.title(\"Emotional Word Usage by Category\")\n",
        "plt.xlabel(\"Words\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "\n",
        "plt.xticks(rotation=20)\n",
        "\n",
        "plt.show()"
